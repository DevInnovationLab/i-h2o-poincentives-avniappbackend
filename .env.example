# ---------------------------------------------------------------------------
# Copy to .env at the repo root and fill in. .env is gitignored; NEVER commit
# it, paste it into an issue, or put a token in a settings file.
#
# These are the only seven variables the code reads. Values are blank except
# the two non-secret defaults.
# ---------------------------------------------------------------------------

# Avni instance. Must match the environment the token was minted for.
AVNI_SERVER=https://app.avniproject.org

# ---------------------------------------------------------------------------
# Auth, option A: paste a token (no dependencies to install).
#
# This MUST be the Cognito *id* token, NOT the access token. Supplying the
# access token -- or an id token minted for a different Avni environment --
# makes the server fail verification and return HTTP 500, with no hint that
# the token is the problem. That confusing 500 is by far the most common
# failure mode of this pipeline. (An expired or malformed token gives 401.)
# ---------------------------------------------------------------------------
AVNI_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Auth, option B: let the code log in to Cognito for you. Requires boto3
# (pip install -r requirements.txt). Leave AVNI_AUTH_TOKEN blank to use this.
# ---------------------------------------------------------------------------
AVNI_USERNAME=
AVNI_PASSWORD=
AVNI_COGNITO_CLIENT_ID=
AVNI_COGNITO_REGION=ap-south-1

# ---------------------------------------------------------------------------
# Publishing. The local Box Drive mount that 1-data/12-avni/ mirrors.
# ---------------------------------------------------------------------------
AVNI_BOX_ROOT=
